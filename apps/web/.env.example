# Local demo mode: set to false to connect directly to the FastAPI backend
VITE_USE_MOCKS=false
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (Optional: used for cloud profile persistence and synced chat)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only AI streaming credential (Optional)
LOVABLE_API_KEY=