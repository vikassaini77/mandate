# MANDATE Backend Environment Variables

# =======================
# Core System Settings
# =======================
# The environment (development, test, production)
ENVIRONMENT=development
# The port the API runs on (used by uvicorn/render)
PORT=8000

# =======================
# Database & Redis
# =======================
# PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mandate
# Redis connection string for rate limiting and pub/sub (SSE)
REDIS_URL=redis://localhost:6379/0

# =======================
# Security & Auth
# =======================
# Secret key for signing JWTs (must be securely generated in prod)
JWT_SECRET=super-secret-development-key-change-me
# Optional CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =======================
# External APIs (LLM)
# =======================
# Anthropic API Key (Required for Agent and Mandate Parser)
ANTHROPIC_API_KEY=sk-ant-api03-...
# The specific model to use (never hardcoded in source)
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =======================
# PayPal Integration
# =======================
# Set to 'true' to completely mock PayPal calls (returns synthetic IDs)
MOCK_PAYPAL=true
# PayPal REST API Base URL (Sandbox default)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PayPal OAuth Credentials
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
